{
  "name": "construction-strategy-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:drecco": "npm run build -- --mode drecco && node -e \"require('node:fs').renameSync('dist/drecco/index.html', 'dist/drecco/iframe.html')\"",
    "package:drecco": "npm run build:drecco && node scripts/package-drecco.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "framer-motion": "12.42.0",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.2",
    "postcss": "^8.5.0",
    "@tailwindcss/postcss": "^4.3.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "4.1.10"
  }
}
